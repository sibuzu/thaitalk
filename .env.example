# Local build configuration only. Never commit .env.
# scripts/build_android.py encodes this key into the APK.
# Encoding is reversible: an APK recipient can potentially recover the key.
AZURE_APIKEY=your-azure-speech-key
AZURE_REGION=southeastasia
# Legacy region inference is also supported:
# AZURE_URL=https://southeastasia.api.cognitive.microsoft.com/
